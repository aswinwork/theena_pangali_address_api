# Copy this file to .env and fill in your own values.

# MongoDB Atlas connection string (free M0 cluster).
# Get this from Atlas: Database > Connect > Drivers > Node.js
# Replace <username>, <password> and <cluster-url>, and make sure the
# database name (here "user_directory") is included before the "?".
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/user_directory?retryWrites=true&w=majority

# Port the API server listens on.
PORT=4000

# Public base URL of this server, used to build full image URLs that the
# mobile app can load (e.g. http://192.168.1.23:4000). During local
# development set this to your computer's LAN IP, NOT localhost, so a
# phone on the same Wi-Fi can reach it.
BASE_URL=http://localhost:4000
